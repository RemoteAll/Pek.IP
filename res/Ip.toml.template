# Pek.IP 配置（TOML）
# 首次加载时若本文件不存在，会自动按模板生成。
# 平台地址固定；如需更换 RPanelServer，只改 StoreUrl 这一项即可。

# RPanelServer 平台地址（默认固定，一般无需修改）
StoreUrl = "https://p.sc8.fun"

# 平台 Ed25519 公钥（从 RPanel「组件源」页复制；非空 = 强制验签）
# 同时用于校验平台下发的 License 与下载票据；留空时仅允许 https 或回环 http，
# 并在首次注册时 TOFU 固定平台公钥（建议显式配置，防中间人替换）
PubKey = ""

# 本地数据目录（仓库 data/ 或部署目录；相对路径按程序目录）
DataDir = "data"

# 下载缓存目录（按需下载的数据包解压到这里）
CacheDir = "Data/IpCache"

# 客户端状态目录（自动生成 installId、Ed25519 私钥、License、平台公钥；勿手工改）
StateDir = "Data/IpClient"

# 自动注册（零身份配置）：首次下载时自动生成 installId/密钥并向平台注册；
# 平台按「配置 → AutoApproveCidrs」自动批准，或管理员在「IP 授权」页手动批准。
# 关闭后不注册、不申请票据（仅适合旧平台/纯本地数据）。
AutoEnroll = true

# 是否允许下载 IPv6 xdb（约 37 MiB；本地有 v6 时总会加载）
DownloadV6 = false

# 平台 https 自定义根证书（PEM 文件；自签/内网 CA 时填写）
CaFile = ""
